# Скопировать в .env: cp .env.example .env
NODE_ENV=development
PORT=3000
APP_VERSION=0.0.0
# Проставляется в CI при сборке (ONW-18)
GIT_SHA=unknown

# Postgres (совпадает с infra/docker-compose.yml)
DATABASE_URL=postgresql://onwave:onwave@localhost:5432/onwave?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=onwave-media
S3_ACCESS_KEY=onwave
S3_SECRET_KEY=onwave123
S3_FORCE_PATH_STYLE=true
# Перед бакетом обычно стоит CDN; пусто — ссылки идут напрямую в S3
S3_PUBLIC_URL=
# Потолок загрузки: вшивается в presigned URL (ONW-34)
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_UPLOAD_URL_TTL_SECONDS=300

# JWT (ONW-22). В проде — длинные случайные значения из секрет-хранилища.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Соц-логин (ONW-23, ONW-24). Через запятую — по client id на платформу.
# Пустое значение запрещает вход через провайдера, а не разрешает любой audience.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Сколько независимых жалоб автоматически скрывают событие (ONW-38)
REPORTS_HIDE_THRESHOLD=3

# Наблюдаемость (ONW-13)
SENTRY_DSN=
LOG_LEVEL=debug

# Swagger вне dev закрыт basic-auth
SWAGGER_USER=onwave
SWAGGER_PASSWORD=onwave

# Геокодинг (ONW-36): nominatim | google | yandex
GEO_PROVIDER=nominatim
GEO_API_KEY=
